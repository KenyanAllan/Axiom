# ── Database (RDS PostgreSQL / local pgvector) ────────────────────────────────
DATABASE_URL=postgresql+asyncpg://axiom:axiom_dev_secret@localhost:5432/axiom
SYNC_DATABASE_URL=postgresql+psycopg2://axiom:axiom_dev_secret@localhost:5432/axiom
DATABASE_SSL=false

# ── Redis / Celery ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── AWS Credentials ───────────────────────────────────────────────────────────
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Amazon Bedrock (LLM + Embeddings) ────────────────────────────────────────
BEDROCK_MODEL_ID=anthropic.claude-sonnet-4-6
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0

# ── Amazon S3 (Source Document Storage) ───────────────────────────────────────
S3_BUCKET_NAME=axiom-source-documents
S3_PRESIGNED_URL_EXPIRY=3600

# ── Amazon Transcribe (Speech-to-Text) ───────────────────────────────────────
TRANSCRIBE_OUTPUT_BUCKET=axiom-transcriptions

# ── Amazon Textract (OCR / Document Text Extraction) ─────────────────────
TEXTRACT_OUTPUT_BUCKET=axiom-textract-results

# ── Amazon Polly (Text-to-Speech) ────────────────────────────────────────────
POLLY_OUTPUT_BUCKET=axiom-audio
POLLY_VOICE_ID=Matthew
POLLY_ENGINE=neural

# ── JWT Auth ──────────────────────────────────────────────────────────────────
# IMPORTANT: Generate a real secret for production:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE-ME-to-a-random-64-char-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ── App ───────────────────────────────────────────────────────────────────────
LOG_LEVEL=info
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
UPLOAD_MAX_BYTES=52428800

# ── Demo auth ────────────────────────────────────────────────────────────────
# Set ENABLE_DEMO_AUTH=false in production to disable X-Demo-User header bypass
ENABLE_DEMO_AUTH=true
DEMO_USER_IDS=usr_student_demo,usr_teacher_demo,usr_learner_demo
RUN_SEED_ON_STARTUP=true
